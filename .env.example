# Configurações do Site
NEXT_PUBLIC_SITE_URL=https://wagnervasconcelos.com.br

# Google Tag Manager, Google Analytics 4 & Google Ads (Fase 9)
# IDs vazios não quebram o site e desativam os scripts correspondentes
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Ativa logs detalhados do dataLayer no console (apenas para desenvolvimento local)
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Formulários & Integrações de Lead (Futuro CRM / Webhook)
# NEXT_PUBLIC_NEWSLETTER_WEBHOOK_URL=
# NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

